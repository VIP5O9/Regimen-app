# REGIMEN — copy to .env and edit. Every value is optional; the app runs without one.
# .env is gitignored.

# ---- push (optional, but reminders don't fire without it) ----
# Apple's push service rejects a fake VAPID subject with a 403, so push stays
# OFF until this is a real mailto: or https: URL that you control.
# REGIMEN_CONTACT=mailto:you@example.com

# ---- access ----
# The API checks off tasks, writes files and sends push, so it is always gated.
# Leave this unset and the server mints a random token into data/token.json and
# prints the sign-in URL on startup. Set it to pin your own (16+ characters).
# REQUIRED on Vercel — there is no persistent disk for token.json.
# REGIMEN_TOKEN=your-secret-token-at-least-16-chars

# ---- network ----
# PORT=3117
# Defaults to 0.0.0.0 because WSL's localhost relay mirrors address family and a
# ::-bound listener is unreachable from Windows at 127.0.0.1. If you're running
# natively and want loopback only, set this.
# REGIMEN_HOST=127.0.0.1

# ---- voice memos ----
# Where recordings + transcripts land. Defaults to data/voice-inbox.
# Point it at an Obsidian vault to write notes straight in:
# REGIMEN_VOICE_DIR=/mnt/c/Users/you/Documents/Obsidian Vault/Voice Inbox
# Turn the feature off entirely:
# REGIMEN_VOICE=off

# ---- storage ----
# REGIMEN_DATA_DIR=./data
